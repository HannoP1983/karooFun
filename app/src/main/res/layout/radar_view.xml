<?xml version="1.0" encoding="utf-8"?>
<!-- Radar tile: the rendered image plus invisible tap areas over what RadarLayout draws.
     Vertically: map with the +/- column (top 85 %), then the footer with the timeline (bottom 15 %).
     The +/- weights match RadarLayout.BUTTONS_TOP / BUTTONS_MIDDLE / BUTTONS_BOTTOM (58 / 72.5 / 85 % of the height).
     A tap anywhere on the timeline steps one frame further. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/radar_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/radar_name"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="85"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="58" />

                <FrameLayout
                    android:id="@+id/zoom_in"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="14.5"
                    android:contentDescription="@string/radar_zoom_in" />

                <FrameLayout
                    android:id="@+id/zoom_out"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="12.5"
                    android:contentDescription="@string/radar_zoom_out" />
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/timeline"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="15"
            android:contentDescription="@string/radar_next_frame" />
    </LinearLayout>
</FrameLayout>
